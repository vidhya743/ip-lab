<?php

// XML file name
$xmlFile = "books.xml";

$message = "";

// Check whether XML file exists
if (!file_exists($xmlFile)) {

    $xml = new SimpleXMLElement(
        '<?xml version="1.0" encoding="UTF-8"?><library></library>'
    );

    $xml->asXML($xmlFile);
}


// --------------------------------------------------
// ADD BOOK
// --------------------------------------------------

if ($_SERVER["REQUEST_METHOD"] == "POST") {

    // Get values from user
    $title = trim($_POST["title"]);
    $author = trim($_POST["author"]);
    $year = trim($_POST["year"]);
    $price = trim($_POST["price"]);


    // Check empty fields
    if ($title == "" || $author == "" || $year == "" || $price == "") {

        $message = "Please enter all book details.";

    } else {

        // Load XML file
        $xml = simplexml_load_file($xmlFile);

        if ($xml === false) {

            $message = "Error: Cannot read books.xml";

        } else {

            // Create new book
            $book = $xml->addChild("book");

            // Add book details
            $book->addChild("title", $title);
            $book->addChild("author", $author);
            $book->addChild("year", $year);
            $book->addChild("price", $price);

            // Save data into XML file
            if ($xml->asXML($xmlFile)) {

                $message = "Book added successfully!";

            } else {

                $message = "Error: Cannot save book data.";
            }
        }
    }
}

?>

