    $xml = simplexml_load_file($xmlFile);


    if ($xml === false) {

        echo "<p class='error'>Error: Cannot load books.xml</p>";

    } else {

        echo "<table>";

        echo "<tr>";
        echo "<th>Title</th>";
        echo "<th>Author</th>";
        echo "<th>Year</th>";
        echo "<th>Price</th>";
        echo "</tr>";


        // Check whether books are available
        if (count($xml->book) == 0) {

            echo "<tr>";
            echo "<td colspan='4'>No books available</td>";
            echo "</tr>";

        } else {

            // Display each book
            foreach ($xml->book as $book) {

                echo "<tr>";

                echo "<td>";
                echo htmlspecialchars($book->title);
                echo "</td>";

                echo "<td>";
                echo htmlspecialchars($book->author);
                echo "</td>";

                echo "<td>";
                echo htmlspecialchars($book->year);
                echo "</td>";

                echo "<td>";
                echo "$" . htmlspecialchars($book->price);
                echo "</td>";

                echo "</tr>";
            }
        }

        echo "</table>";
    }

